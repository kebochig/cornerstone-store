---
import Base from '../layouts/Base.astro';
import { getProducts, formatPrice, sizeLabel, sizeName, sortSizes, LOW_STOCK } from '../lib/sanity.js';

const products = await getProducts();
const categories = [...new Set(products.map((p) => p.category))].sort();
const sizes = sortSizes(new Set(products.flatMap((p) => p.sizes)));
---
<Base>
  <section class="filters">
    <input id="f-search" type="search" placeholder="Search products…" />
    <div class="chips" id="f-cat">
      <button class="chip active" data-cat="">All</button>
      {categories.map((c) => <button class="chip" data-cat={c}>{c}</button>)}
    </div>
    <select id="f-size">
      <option value="">Any size</option>
      {sizes.map((s) => <option value={s}>{sizeName(s)}</option>)}
    </select>
  </section>

  <p id="f-empty" class="empty" hidden>No products match these filters.</p>

  <section class="grid">
    {products.map((p) => (
      <article
        class="card"
        data-product={JSON.stringify({ slug: p.slug, name: p.name, price: p.price, stock: p.stock })}
        data-cat={p.category}
        data-sizes={p.sizes.join('|')}
        data-name={p.name.toLowerCase()}
      >
        <a href={`/product/${p.slug}/`} class="thumb">
          {p.images[0] && <img src={p.images[0]} alt={p.name} loading="lazy" />}
          {p.pinned && <span class="tag featured" role="img" aria-label="Featured" title="Featured">★</span>}
          {!p.inStock && <span class="tag">Sold out</span>}
          {p.inStock && p.left !== null && p.left <= LOW_STOCK && <span class="tag low">Only {p.left} left</span>}
        </a>
        <div class="info">
          <a href={`/product/${p.slug}/`} class="name">{p.name}</a>
          <span class="price">{formatPrice(p.price)}</span>
          <div class="sizes">{p.sizes.map((s) => <span>{s}</span>)}</div>
          {p.inStock && (
            <div class="buy">
              {p.sizes.length > 0 && (
                <select name="size" aria-label="Size">
                  <option value="">Size</option>
                  {p.sizes.map((s) => <option value={s}>{sizeLabel(p, s)}</option>)}
                </select>
              )}
              <button class="btn" data-add>Add</button>
            </div>
          )}
        </div>
      </article>
    ))}
  </section>

  <script>
    import { track } from '../scripts/track.js';

    const cards = [...document.querySelectorAll('.card')];
    const search = document.getElementById('f-search');
    const size = document.getElementById('f-size');
    let cat = '';

    function apply() {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      for (const c of cards) {
        const ok =
          (!cat || c.dataset.cat === cat) &&
          (!size.value || c.dataset.sizes.split('|').includes(size.value)) &&
          (!q || c.dataset.name.includes(q));
        c.hidden = !ok;
        shown += ok;
      }
      document.getElementById('f-empty').hidden = shown > 0;
    }

    document.getElementById('f-cat').addEventListener('click', (e) => {
      const b = e.target.closest('.chip');
      if (!b) return;
      document.querySelectorAll('.chip').forEach((x) => x.classList.toggle('active', x === b));
      cat = b.dataset.cat;
      apply();
      if (cat) track('filter-category', { category: cat });
    });

    // Record a search only once the person stops typing.
    let searchTimer;
    search.addEventListener('input', () => {
      apply();
      clearTimeout(searchTimer);
      const q = search.value.trim().toLowerCase();
      if (q.length >= 2) searchTimer = setTimeout(() => track('search', { query: q }), 1000);
    });
    size.addEventListener('change', () => {
      apply();
      if (size.value) track('filter-size', { size: size.value });
    });
  </script>
</Base>
